# Generate a private .env with: python3 scripts/create-docker-env.py
# This example contains no real credentials. Never commit the generated .env.
DB_USER=moonio
DB_PASSWORD=replace-with-a-local-random-password
DB_ROOT_PASSWORD=replace-with-a-different-local-random-password
LOCAL_UID=1000
LOCAL_GID=1000
WEB_PORT=8080
PHPMYADMIN_PORT=8081
APP_BASE_URL=http://localhost:8080/blog/
CHAT_ALLOWED_ORIGIN=http://localhost:8080

# 32 random bytes, base64 encoded. Keep the same key to read old encrypted messages.
MESSAGE_ENCRYPTION_KEY=
SMTP_USER=
SMTP_PASSWORD=
HTTPS_PORT=8443
