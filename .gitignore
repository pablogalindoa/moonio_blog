# Dependencies at any depth; keep package manifests and lockfiles.
node_modules/
/vendor/
.pnp
.pnp.*

# Local environment files and private key material.
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
*.p12
*.pfx

# Existing credential-bearing source: preserve locally, do not commit.
# No credentials are removed or rotated during the baseline phase.
/application/controllers/ExternalApi.php
/application/controllers/PageController.php

# Private database exports, verification details, and persistent user uploads.
/application/database/
/uploads/
/database/
*.sql
*.sql.*
*.dump
*.sqlite
*.sqlite3
*.db

# Local backups and future database-volume directories.
/backups/
/private-backups/
/docker-data/
/docker/volumes/
/docker/mysql/
/docker/mariadb/
/volumes/
/mysql-data/
/mariadb-data/
*.tar
*.tar.gz
*.tgz
*.zip

# Runtime files; retain the framework's directory scaffolding.
/application/cache/*
!/application/cache/index.html
/application/logs/*
!/application/logs/index.html
*.log
*.log.*
*.pid
*.sock
*.tmp
*.temp
*.swp
*.swo
*~
.cache/
/tmp/
/temp/

